// Postgres (Supabase, provisioned via Vercel's integration). POSTGRES_PRISMA_URL
// is the pooled (PgBouncer) connection used at runtime; POSTGRES_URL_NON_POOLING
// is the direct connection Prisma needs for schema pushes/migrations, which
// can't go through a pooler. Schema intentionally avoids Postgres-only
// features (scalar arrays, native enums) so it stays portable if needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ---------- Destinations & content ----------

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  status      String   @default("draft") // draft | preview | live
  priceCents  Int      @default(15000) // 150.00 in agora/cents, currency below
  currency    String   @default("ILS")
  heroImage   String?
  heroCopy    String?
  themeConfig String // JSON: colors, font pair, shape tokens, motif image
  continent   String   @default("europe") // europe | asia | africa | americas | oceania | middle-east
  isBestSeller Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas        Area[]
  subscriptions SubscriptionDestination[]
  phrasebook   PhrasebookEntry[]
  coupons      Coupon[]
  itineraries  Itinerary[]
  expenses     Expense[]
  logistics    TripLogistic[]
  kmlImports   KmlImport[]
  budgets      TripBudget[]
  priceQuotes  PriceQuote[]
  locationPings LocationPing[]
  albumMedia   AlbumMedia[]
  albumSettings AlbumSettings[]
  quizQuestions QuizQuestion[]
  quizAttempts QuizAttempt[]
  tips         DestinationTip[]
  itineraryTemplates ItineraryTemplate[]
  savedMapPins SavedMapPin[]
}

model Area {
  id            String   @id @default(cuid())
  destinationId String
  name          String
  centerLat     Float?
  centerLng     Float?

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  categories  Category[]

  @@index([destinationId])
}

model Category {
  id       String  @id @default(cuid())
  areaId   String
  name     String
  colorHex String  @default("#888888")
  iconKey  String  @default("pin")

  area Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  pois PointOfInterest[]

  @@index([areaId])
}

model PointOfInterest {
  id                String   @id @default(cuid())
  categoryId        String
  name              String
  lat               Float
  lng               Float
  geometryType      String   @default("point") // point | line | polygon
  geometryCoords    String? // JSON array of [lng,lat] pairs for line/polygon
  // The KML placemark's own resolved styleUrl color — distinct from
  // Category.colorHex (which is just one representative swatch per
  // category/folder, taken from its first placemark). Matters most for line/
  // polygon geometries grouped under one category (e.g. several differently
  // colored metro lines all inside a single "מטרו" folder) where every
  // placemark needs its own real color, not the folder's shared one.
  colorHex          String?
  rawDescriptionHtml String?
  address           String?
  priceRange        String?
  bookingUrl        String?
  tip               String?
  hours             String?
  wantsBooking      Boolean  @default(false)
  isMustSee         Boolean  @default(false) // flagged as one of the destination's unmissable highlights
  website           String? // real official site, found by AI enrichment — distinct from bookingUrl (tour/ticket booking specifically)
  enrichedAt        DateTime? // set once AI enrichment (real photo/description/website) has run for this POI, so re-runs skip it
  createdAt         DateTime @default(now())

  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        PoiTag[]
  photos      PoiPhoto[]
  favorites   Favorite[]
  itineraryItems ItineraryItem[]

  @@index([categoryId])
}

model PoiTag {
  id    String @id @default(cuid())
  poiId String
  label String

  poi PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId])
}

model PoiPhoto {
  id    String @id @default(cuid())
  poiId String
  url   String

  poi PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId])
}

model KmlImport {
  id            String   @id @default(cuid())
  destinationId String
  fileName      String
  rawXml        String
  status        String   @default("pending_review") // pending_review | published
  placemarkCount Int     @default(0)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

// ---------- Users, auth, subscriptions ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Gamification: level-up subscription credits (see lib/credits.ts). The
  // level itself is always recomputed live from current stats — these three
  // fields exist only to detect a real level-up event (so credit is awarded
  // exactly once per level gained) and to track the monthly earning window.
  highestLevelReached    Int      @default(1)
  subscriptionCreditCents Int     @default(0)
  creditsMonthKey        String?

  // The last destination this user actually browsed (updated by
  // trip/[slug]/layout.tsx) — preferred over the deterministic random pick
  // as the shell's default destination context (see (shell)/layout.tsx),
  // so "the destination they chose" sticks instead of drifting.
  defaultDestinationSlug String?

  // Referral program (see lib/referral.ts): a short shareable code (lazily
  // generated on first profile visit), who referred this user (if anyone),
  // and when the referral reward was granted (guards against double-paying
  // credit if the reward-check ever runs twice for the same user).
  referralCode       String?   @unique
  referredByUserId   String?
  referralRewardedAt DateTime?
  referredBy User?  @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals  User[] @relation("Referrals")

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  favorites     Favorite[]
  itineraries   Itinerary[]
  itineraryItemVotes ItineraryItemVote[]
  expenses      Expense[]
  logistics     TripLogistic[]
  budgets       TripBudget[]
  packingChecks PackingCheck[]
  plannerProfile PlannerProfile?
  priceQuotes   PriceQuote[]
  albumMedia    AlbumMedia[]
  albumSettings AlbumSettings[]
  quizAttempts  QuizAttempt[]
  itineraryTemplates ItineraryTemplate[]
  visitedCountries VisitedCountry[]
  locationPings LocationPing[]
  phrasebookProgress PhrasebookProgress[]
  savedMapPins SavedMapPin[]
  countryPhotos CountryPhoto[]
  pushSubscriptions PushSubscription[]
  expenseSplits ExpenseSplit[]
}

/** Org-tier trip planners can brand client-facing exported plans with their
 * own company name + logo, shown alongside the Oded HaMapper branding. */
model PlannerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  logoUrl     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  planKey           String   // solo | family | org
  billingCycle      String   // monthly | annual
  status            String   @default("pending") // pending | active | canceled
  cancelAtPeriodEnd Boolean  @default(false)
  paymentSessionId  String   @unique
  amountCents       Int
  currency          String   @default("USD")
  currentPeriodEnd  DateTime
  createdAt         DateTime @default(now())

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations SubscriptionDestination[]
  members      SubscriptionMember[]

  @@index([userId])
}

/** Extra seats on a Family/Org subscription. Membership is resolved by email
 * match at access-check time (see getActiveSubscription in access.ts) rather
 * than requiring the invited person to "claim" anything — as soon as they
 * sign up or log in with the invited email, they get access. */
model SubscriptionMember {
  id            String    @id @default(cuid())
  subscriptionId String
  invitedEmail  String
  createdAt     DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // getActiveSubscription (lib/access.ts) — called on every navigation for
  // every seat member — looks this up by invitedEmail directly, not through
  // subscriptionId, so the (subscriptionId, invitedEmail) unique above (whose
  // leading column is subscriptionId) doesn't serve that lookup at all.
  @@unique([subscriptionId, invitedEmail])
  @@index([invitedEmail])
}

model SubscriptionDestination {
  id             String   @id @default(cuid())
  subscriptionId String
  destinationId  String
  assignedAt     DateTime @default(now()) // used to enforce the 14-day swap cooldown

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  destination  Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, destinationId])
}

// ---------- In-app trip data ----------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  poiId     String
  createdAt DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi  PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([userId, poiId])
}

model Itinerary {
  id            String  @id @default(cuid())
  userId        String
  destinationId String
  kind          String  @default("personal") // personal | client (gold-tier trip-planner tool)
  label         String? // client/trip name, used when kind=client
  shareToken    String? @unique // set when the owner enables a read-only client link

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  days        ItineraryDay[]

  @@unique([userId, destinationId, kind])
}

model ItineraryDay {
  id          String @id @default(cuid())
  itineraryId String
  dayIndex    Int
  note        String?

  itinerary Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]

  @@index([itineraryId])
}

model ItineraryItem {
  id              String  @id @default(cuid())
  itineraryDayId  String
  poiId           String?
  customLabel     String? // freeform item (e.g. a side-trip/town not in the DB)
  timeOfDay       String? // "HH:MM" free text
  order           Int     @default(0)
  note            String?

  day   ItineraryDay        @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  poi   PointOfInterest?    @relation(fields: [poiId], references: [id], onDelete: Cascade)
  votes ItineraryItemVote[]

  @@index([itineraryDayId])
  @@index([poiId])
}

/** One like/dislike per co-traveler per itinerary item — lets everyone
 * sharing a family/org subscription weigh in on a shared itinerary (see
 * resolveItineraryOwnerId in access.ts) so the group can see at a glance
 * which stops are unpopular and worth cutting. */
model ItineraryItemVote {
  id              String   @id @default(cuid())
  itineraryItemId String
  userId          String
  value           Int // 1 = like, -1 = dislike
  createdAt       DateTime @default(now())

  item ItineraryItem @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itineraryItemId, userId])
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  category      String
  amountCents   Int      // always the ILS amount — every budget/total calc assumes this
  currency      String   @default("ILS")
  note          String?
  spentAt       DateTime @default(now())

  // Set only when the expense was entered in a foreign currency: the
  // original entered amount/currency, kept for display transparency
  // ("₪45 · הומר מ-€11"), while amountCents/currency above stay the
  // ILS-converted source of truth every existing calc already relies on.
  originalAmountCents Int?
  originalCurrency    String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  splits      ExpenseSplit[]

  @@index([userId, destinationId])
}

/** One row per participant (other than the payer) on a shared expense —
 * lets a family/group subscription split a cost and see who owes whom
 * (settle-up math lives in lib/costSplitting.ts, not persisted). */
model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  shareCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

/** A browser's Web Push subscription (see lib/push.ts) — one row per
 * device/browser a user has granted notification permission on. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** One GPS point recorded while the "my location" tracker was on. Rendered
 * on the map as a green breadcrumb trail — the streets the user has
 * physically walked in this destination. */
model LocationPing {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  lat           Float
  lng           Float
  recordedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId, recordedAt])
}

/** A Google-Maps place a paying user chose to "save to the map" from the
 * native Google POI layer (toggled on via MapScreen) — personal to that
 * user+destination only, never shared into the shared destination dataset. */
model SavedMapPin {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  placeId       String
  name          String
  lat           Float
  lng           Float
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId, placeId])
}

/** A photo manually attached to a visited country on the profile/quizzes
 * world map (as opposed to a destination album photo, which is auto-merged
 * in alongside these at read time — see resolveCountryPhotos()). */
model CountryPhoto {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  url         String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, countryCode])
}

model TripLogistic {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  type          String // flight | hotel | passport | visa | insurance | vaccination | ticket | other
  detailsJson   String // JSON blob: carrier/flightNo/hotelName/etc.
  confirmationNumber String?
  imageUrl      String?
  address       String? // free-text address, geocoded server-side into lat/lng for the map pin
  lat           Float?
  lng           Float?
  startsAt      DateTime?
  endsAt        DateTime?
  // Set once a flight check-in push has actually been sent for this entry,
  // so the notification cron never sends the same reminder twice.
  checkinNotifiedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId])
}

model TripBudget {
  id            String @id @default(cuid())
  userId        String
  destinationId String
  totalCents    Int
  currency      String @default("ILS")
  tripDays      Int    @default(1)
  // Last time a "you're close to/over budget" push was sent — at most one
  // per calendar day, checked/set by the notification cron.
  lastAlertedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model PhrasebookEntry {
  id            String @id @default(cuid())
  destinationId String
  localPhrase   String
  translation   String
  pronunciation String?
  category      String @default("general")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  progress    PhrasebookProgress[]

  @@index([destinationId])
}

/** Marks a phrasebook entry as "known" by a given user — lets the phrasebook
 * screen show a check + progress count instead of being a flat word list. */
model PhrasebookProgress {
  id      String @id @default(cuid())
  userId  String
  entryId String

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry PhrasebookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

model Coupon {
  id            String  @id @default(cuid())
  destinationId String? // null = global coupon, shown for every destination
  partnerName   String
  discountDesc  String
  code          String?
  url           String?

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model PackingCheck {
  id            String  @id @default(cuid())
  userId        String
  destinationId String
  itemKey       String
  checked       Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId, itemKey])
}

/** Gold-tier trip-planner tool: an itemized price quote + boilerplate service
 * agreement, auto-assembled from a template (not a live AI call — no LLM API
 * is configured), that a planner can send to a client for lightweight
 * acceptance. Acceptance here is NOT a legally binding e-signature. */
model PriceQuote {
  id                 String   @id @default(cuid())
  userId             String
  destinationId      String
  clientName         String
  tripDays           Int
  basePriceCents     Int
  includesBooking    Boolean  @default(false)
  bookingPriceCents  Int      @default(0)
  currency           String   @default("USD")
  notes              String?
  status             String   @default("draft") // draft | sent | accepted
  leadStatus         String   @default("lead") // lead | quoted | planning | closed_won | closed_lost — CRM pipeline stage
  costCents          Int      @default(0) // agent's cost, for the profit/margin section
  signatureDataUrl   String? // captured signature image (data URL) — a real signature record, not a certified legal e-sign provider
  signedAt           DateTime?
  shareToken         String?  @unique
  acceptedAt         DateTime?
  createdAt          DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId])
}

/** User-uploaded trip photos/videos for the "Album" screen — distinct from
 * PoiPhoto (curated content shown on POI cards). Backed by Vercel Blob in
 * production (BLOB_READ_WRITE_TOKEN); falls back to local /public/uploads
 * in dev where that token isn't set. */
model AlbumMedia {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  type          String // photo | video
  url           String
  caption       String?
  dayIndex      Int? // which trip day this belongs to, for day-grouped album layouts
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId])
}

/** One row per user+destination — the digital album's look (template,
 * background) and freeform day/section titles, plus a share token so the
 * PDF-export page can render it without exposing the editor itself. */
model AlbumSettings {
  id              String  @id @default(cuid())
  userId          String
  destinationId   String
  templateKey     String  @default("polaroid") // polaroid | timeline | postcard
  backgroundColor String?
  daysJson        String? // { [dayIndex]: { title, subtitle } }
  shareToken      String? @unique

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  destinationId String
  category      String // history | geography | politics | sports | culture | food
  question      String
  options       String // JSON array of 4 strings
  correctIndex  Int

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  destinationId  String
  score          Int
  totalQuestions Int
  completedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId])
}

/** A country the user marks as "been there" on their personal travel map —
 * global to the user (not tied to a specific purchased destination), shown
 * on both the quizzes screen and the profile. countryCode is ISO 3166-1
 * alpha-2 (e.g. "IT", "JP"). */
model VisitedCountry {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  visitedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryCode])
}

/** Practical "before you go" tips (customs, money, transport, visa) shown on
 * the Favorites screen, distinct from PhrasebookEntry (language) and
 * PointOfInterest.tip (a single POI's tip). */
model DestinationTip {
  id            String @id @default(cuid())
  destinationId String
  category      String // before | customs | money | transport | visa | general
  text          String

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

/** A saved snapshot of a client-planner itinerary's days/items, reusable as
 * a starting point for a future client without rebuilding from scratch. */
model ItineraryTemplate {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  name          String
  kind          String   @default("client") // personal | client — keeps the two builders' saved-itinerary lists separate
  daysJson      String // snapshot: [{dayIndex, note, items: [{customLabel, poiId, timeOfDay, note, order}]}]
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId, kind])
}

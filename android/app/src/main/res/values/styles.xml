<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Edge-to-edge at the TOP ONLY: transparent status bar so the WebView's
         own page background reaches the physical top of the screen instead
         of a visibly different-colored strip sitting above it. The bottom
         nav bar color (travi_nav_bar) stays opaque/matched rather than
         transparent, and MainActivity does NOT additionally pad the content
         root for the bottom inset — the web page's own
         env(safe-area-inset-bottom) CSS (see AppSidebar's mobile bottom nav)
         already reserves that space; adding native padding on top of it
         double-counted the inset and left a real empty gap above the bottom
         nav bar, confirmed live. One layer of bottom-inset handling only. -->
    <!-- postSplashScreenTheme (below) is the piece that was missing and is
         very likely the real cause of a persistent top bar (app icon + name)
         some users saw stuck on screen, worst on Samsung's OneUI: this theme
         declares itself a Theme.SplashScreen but the app never actually
         called the Android 12+ SplashScreen API (see
         SplashScreen.installSplashScreen in MainActivity) or told it which
         theme to hand off to once ready — without that hand-off the OS can
         be left holding onto splash-derived chrome indefinitely on some OEM
         skins instead of cleanly switching to the real app theme below. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/travi_nav_bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>